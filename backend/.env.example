PROJECT_NAME="AgriChain API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="agrichain_super_secret_development_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="root"
MYSQL_DATABASE="agrichain_db"

# Direct connection URL for SQLAlchemy (PyMySQL driver)
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/agrichain_db"

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ─────────────────────────────────────────────────────────────────────────────
# Market Prices Feature — API Keys
# ─────────────────────────────────────────────────────────────────────────────

# Official Agricultural Market Prices Data API (Government of India OGD)
# Dataset: "Current Daily Price of Various Commodities from Various Markets (Mandi)"
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# Register for a free API key: https://data.gov.in/user/register
# If empty, the service automatically uses the curated AGMARKNET benchmark snapshot.
MARKET_DATA_API_KEY=""
DATA_GOV_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"

# Crop Photograph API — Pexels (primary image provider, server-side only)
# ⚠️  NEVER place this key in VITE_* frontend variables — backend use ONLY.
# The service resolution chain is: Pexels → Wikipedia → Curated CDN fallback.
# Free API key: https://www.pexels.com/api/
CROP_IMAGE_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Live Shipment Tracking & Maps
# ─────────────────────────────────────────────────────────────────────────────
# Map tile provider (OpenStreetMap tiles are public & free under ODbL)
# Standard OSM: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# Optional routing service URL (OSRM)
ROUTING_API_URL="https://router.project-osrm.org"
